@namespace Social.Admin.Web.Components.Modals
@using Social.Admin.Web.Models

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleCancel">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@(Model.Hide ? "Hide Content" : "Restore Content")</h3>
                <button class="modal-close" @onclick="HandleCancel">&times;</button>
            </div>
            <div class="modal-body">
                <p class="modal-instruction">
                    You are @(Model.Hide ? "hiding" : "restoring") @Model.ItemType ID: <code>@Model.ItemId</code>.
                </p>

                <div class="form-group">
                    <label>Reason / Audit Explanation</label>
                    <textarea class="form-control" rows="3" placeholder="Explain the moderation justification..." @bind="Model.Reason"></textarea>
                    @if (string.IsNullOrWhiteSpace(Model.Reason) && ShowValidation)
                    {
                        <span class="validation-error">Please provide a moderation reason.</span>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
                <button class="btn @(Model.Hide ? "btn-danger" : "btn-success")" @onclick="HandleSubmit">
                    @(Model.Hide ? "Confirm Hide" : "Confirm Restore")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public ModerationActionModel Model { get; set; } = new();
    [Parameter] public EventCallback<ModerationActionModel> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool ShowValidation { get; set; } = false;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(Model.Reason))
        {
            ShowValidation = true;
            return;
        }

        await OnConfirm.InvokeAsync(Model);
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleCancel()
    {
        ShowValidation = false;
        await OnCancel.InvokeAsync();
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
