@namespace Social.Admin.Web.Components.Modals
@using Social.Admin.Web.Models

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleCancel">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">Administrative Password Reset</h3>
                <button class="modal-close" @onclick="HandleCancel">&times;</button>
            </div>
            <div class="modal-body">
                <p class="modal-instruction">
                    Set a new password for user: <strong>@Model.UserName</strong>.
                </p>

                <div class="form-group">
                    <div class="label-with-action">
                        <label>New Password</label>
                        <button type="button" class="btn-link-action" @onclick="GenerateStrongPassword">Generate Strong</button>
                    </div>
                    <input type="text" class="form-control" placeholder="Min 6 characters, uppercase, lowercase, digit, symbol" @bind="Model.NewPassword" />
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="text" class="form-control" placeholder="Re-enter password" @bind="Model.ConfirmPassword" />
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger">@ErrorMessage</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
                <button class="btn btn-warning" @onclick="HandleSubmit">Reset Password</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public ResetPasswordModalModel Model { get; set; } = new();
    [Parameter] public EventCallback<ResetPasswordModalModel> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string? ErrorMessage;

    private void GenerateStrongPassword()
    {
        var random = new Random();
        var chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%^&*";
        var pwd = new char[12];
        for (int i = 0; i < 12; i++)
        {
            pwd[i] = chars[random.Next(chars.Length)];
        }
        Model.NewPassword = new string(pwd) + "A1!";
        Model.ConfirmPassword = Model.NewPassword;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(Model.NewPassword) || Model.NewPassword.Length < 6)
        {
            ErrorMessage = "Password must be at least 6 characters long.";
            return;
        }

        if (Model.NewPassword != Model.ConfirmPassword)
        {
            ErrorMessage = "Passwords do not match.";
            return;
        }

        ErrorMessage = null;
        await OnConfirm.InvokeAsync(Model);
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleCancel()
    {
        ErrorMessage = null;
        await OnCancel.InvokeAsync();
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
